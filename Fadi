
name: Gerar APK WA Autoatendimento V16.2.7

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  gerar-apk:
    runs-on: ubuntu-latest
    timeout-minutes: 40

    steps:
      - name: Baixar arquivos do repositorio
        uses: actions/checkout@v4

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Localizar e preparar projeto V16.2.7
        shell: bash
        run: |
          set -euo pipefail

          ZIP="$GITHUB_WORKSPACE/WA_Autoatendimento_V16_2_7_SELETOR_SONS_CORRIGIDO.zip"

          if [ ! -f "$ZIP" ]; then
            echo "::error::O ZIP corrigido precisa estar na raiz do repositorio."
            find "$GITHUB_WORKSPACE" -maxdepth 2 -type f
            exit 1
          fi

          BUILD_DIR="$RUNNER_TEMP/wa-autoatendimento-v1627"
          mkdir -p "$BUILD_DIR"
          unzip -q "$ZIP" -d "$BUILD_DIR"

          SETTINGS="$(find "$BUILD_DIR" -type f -name settings.gradle -print -quit)"
          if [ -z "$SETTINGS" ]; then
            echo "::error::Nao foi encontrado settings.gradle dentro do ZIP."
            exit 1
          fi

          PROJECT_DIR="$(dirname "$SETTINGS")"

          test -f "$PROJECT_DIR/build.gradle"
          test -f "$PROJECT_DIR/app/build.gradle"
          test -f "$PROJECT_DIR/app/src/main/AndroidManifest.xml"
          test -f "$PROJECT_DIR/app/src/main/java/com/autoatendimento/app/MainActivity.java"
          test -f "$PROJECT_DIR/app/src/main/java/com/autoatendimento/app/WhatsAppNotificationService.java"
          test -f "$PROJECT_DIR/app/src/main/assets/index.html"

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Projeto V16.2.7 localizado."

      - name: Configurar Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Compilar APK sem modificar o aplicativo
        shell: bash
        run: |
          set -uo pipefail
          cd "$PROJECT_DIR"

          gradle --no-daemon --console=plain \
            :app:assembleDebug \
            2>&1 | tee "$RUNNER_TEMP/compilacao-apk.log"

      - name: Disponibilizar APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: WA-Autoatendimento-V16.2.7-APK
          path: ${{ env.PROJECT_DIR }}/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Salvar log se a compilacao falhar
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: diagnostico-compilacao-V16.2.7
          path: ${{ runner.temp }}/compilacao-apk.log
          if-no-files-found: warn
          retention-days: 7
